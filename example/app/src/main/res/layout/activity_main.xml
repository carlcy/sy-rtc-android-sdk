<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="8dp">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="连接配置"
                android:textStyle="bold"
                android:paddingBottom="4dp" />

            <EditText
                android:id="@+id/inputAppId"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="appId"
                android:inputType="text"
                android:singleLine="true" />

            <EditText
                android:id="@+id/inputApiBase"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="apiBaseUrl (如 http://10.0.2.2:8080/demo-api)"
                android:inputType="textUri"
                android:singleLine="true" />

            <EditText
                android:id="@+id/inputSignaling"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="signalingUrl (ws://...)"
                android:inputType="textUri"
                android:singleLine="true" />

            <EditText
                android:id="@+id/inputAppSecret"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="X-App-Secret（仅用于从后端拉 Token）"
                android:inputType="textPassword"
                android:singleLine="true" />

            <EditText
                android:id="@+id/inputChannel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="channelId"
                android:inputType="text"
                android:singleLine="true" />

            <EditText
                android:id="@+id/inputUid"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="uid"
                android:inputType="text"
                android:singleLine="true" />

            <EditText
                android:id="@+id/inputToken"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="RTC Token（可粘贴；空则点击「拉取 Token」）"
                android:inputType="textMultiLine"
                android:minLines="2" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="4dp">

                <Button
                    android:id="@+id/btnFetchToken"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="拉取 Token"
                    android:textAllCaps="false" />

                <Button
                    android:id="@+id/btnInit"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="初始化"
                    android:textAllCaps="false" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnJoin"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="加入频道"
                    android:textAllCaps="false" />

                <Button
                    android:id="@+id/btnLeave"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="离开频道"
                    android:textAllCaps="false" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnMuteAudio"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="静音音频"
                    android:textAllCaps="false" />

                <Button
                    android:id="@+id/btnMuteVideo"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="关闭视频"
                    android:textAllCaps="false" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnEnableVideo"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="启用视频"
                    android:textAllCaps="false" />

                <Button
                    android:id="@+id/btnPreview"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="本地预览"
                    android:textAllCaps="false" />
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="本地 / 远端画面（真机摄像头；模拟器视频可能不可用）"
                android:textStyle="bold"
                android:paddingTop="8dp"
                android:paddingBottom="4dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="180dp"
                android:orientation="horizontal">

                <FrameLayout
                    android:id="@+id/localVideoContainer"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:layout_marginEnd="4dp"
                    android:background="#222222" />

                <FrameLayout
                    android:id="@+id/remoteVideoContainer"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:layout_marginStart="4dp"
                    android:background="#333333" />
            </LinearLayout>

            <TextView
                android:id="@+id/statusText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingTop="8dp"
                android:text="就绪"
                android:textStyle="bold" />
        </LinearLayout>
    </ScrollView>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="日志"
        android:textStyle="bold"
        android:paddingTop="4dp" />

    <ScrollView
        android:id="@+id/logScroll"
        android:layout_width="match_parent"
        android:layout_height="140dp"
        android:background="#111111"
        android:padding="6dp">

        <TextView
            android:id="@+id/logText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#A5D6A7"
            android:textSize="11sp"
            android:fontFamily="monospace"
            android:text="(log)\n" />
    </ScrollView>
</LinearLayout>
